digraph NetworkStructure {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.55",
    ranksep="0.75",
    splines=ortho,
    fontname="DejaVu Sans"
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#3B4A5A",
    fillcolor="#F7FAFC",
    fontname="DejaVu Sans",
    fontsize=11,
    margin="0.12,0.08"
  ];

  edge [
    color="#56616F",
    arrowsize=0.75,
    fontname="DejaVu Sans",
    fontsize=10
  ];

  subgraph cluster_actor {
    label="Shared Pursuer Actor (used by all 3 drones)";
    color="#5B8DEF";
    penwidth=2;
    style="rounded";
    fontsize=14;

    actor_obs [
      fillcolor="#EAF2FF",
      label="Per-agent observation TensorDict\nstate_self + cooperation\nstate_others + optional cylinders"
    ];
    actor_embed [
      label="Entity embeddings\nself_embed: Linear -> 128\nother_embed: Linear -> 128\ncylinder_embed: Linear -> 128"
    ];
    actor_tokens [
      label="Token concat + mask\nLayerNorm(128)"
    ];
    actor_transformer [
      fillcolor="#FFF7E6",
      label="TransformerEncoder x 2\nembed_dim=128\nnum_heads=4\nfeedforward=256\nactivation=GELU, dropout=0"
    ];
    actor_feature [
      label="Encoded self token\nfeature_dim = 128"
    ];
    actor_head [
      fillcolor="#EFFFF4",
      label="TanhIndependentNormal action head\nfc_mean: Linear 128 -> 4\nlearned log_std: [4]\ntanh-bounded distribution"
    ];
    actor_action [
      fillcolor="#EFFFF4",
      label="PIDrate action [4]\nomega_x, omega_y, omega_z, thrust"
    ];

    actor_obs -> actor_embed -> actor_tokens -> actor_transformer -> actor_feature -> actor_head -> actor_action;
  }

  subgraph cluster_critic {
    label="Centralized Critic";
    color="#E49B3F";
    penwidth=2;
    style="rounded";
    fontsize=14;

    critic_state [
      fillcolor="#FFF4E6",
      label="Centralized state\nagents/state\nCTDE input"
    ];
    critic_embed [
      label="RelationEncoder\nSplitEmbedding\nembed_dim=72"
    ];
    critic_pair [
      label="Pairwise relation ij(a)\nconcat pair embeddings"
    ];
    critic_g [
      label="g network\nMLP: 144 -> 256\nLayerNorm(256)"
    ];
    critic_sum [
      label="sum over pairs"
    ];
    critic_f [
      label="f network\nMLP: 256 -> 128"
    ];
    critic_value [
      fillcolor="#FFF4E6",
      label="Value head\nLinear 128 -> state_value"
    ];

    critic_state -> critic_embed -> critic_pair -> critic_g -> critic_sum -> critic_f -> critic_value;
  }

  subgraph cluster_tp {
    label="Target Prediction Network (TP)";
    color="#7D6CF2";
    penwidth=2;
    style="rounded";
    fontsize=14;

    tp_input [
      fillcolor="#F1EFFF",
      label="TP input sequence\nhistory_step = 10\nfeature_dim = 19\nstep + target pos/vel + 4 drone positions"
    ];
    tp_lstm [
      fillcolor="#F1EFFF",
      label="LSTM\nnum_layers = 1\nhidden_dim = 64\nbatch_first = true"
    ];
    tp_fc [
      fillcolor="#F1EFFF",
      label="FC output\nLinear 64 -> 15"
    ];
    tp_pred [
      fillcolor="#F1EFFF",
      label="tanh normalized prediction\nfuture_predcition_step = 5\n5 x target xyz"
    ];

    tp_input -> tp_lstm -> tp_fc -> tp_pred;
  }

  subgraph cluster_losses {
    label="Training Couplings";
    color="#7A8794";
    style="rounded,dashed";
    fontsize=14;

    expert [
      fillcolor="#FFECEC",
      label="Batched Expert2 policy\noracle_pos + lookahead\nclose=true, rush=false"
    ];
    expert_kl [
      fillcolor="#FFECEC",
      label="Expert KL / fixed_std_nll\n0.5 * MSE(actor_mean, expert_action) / 0.15^2\nalpha: 0.4 -> 0.05"
    ];
    ppo [
      fillcolor="#EEF9FF",
      label="PPO loss\npolicy_loss + alpha * expert_kl\ncritic value_loss"
    ];
    reward [
      fillcolor="#F2FFF0",
      label="Environment reward\ncapture + goal penalty + role reward\nspread + collision + landed + time"
    ];
  }

  actor_action -> reward [label="executes in Isaac/PIDrate"];
  tp_pred -> actor_obs [label="included in state/obs", style=dashed];
  tp_pred -> reward [label="role waypoint uses TP pred", style=dashed];
  expert -> expert_kl [label="expert_action"];
  actor_head -> expert_kl [label="actor mean", style=dashed];
  reward -> ppo [label="returns/advantages"];
  expert_kl -> ppo [label="aux actor loss"];
  critic_value -> ppo [label="value loss"];
}
